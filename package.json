{
  "name": "dental-management-backend",
  "version": "1.0.0",
  "description": "Node.js backend for Algerian Dental Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:db": "node scripts/test-db-connection.js",
    "seed": "node scripts/seed-sql.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --forceExit --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --watch --forceExit --detectOpenHandles"
  },
  "keywords": [
    "dental",
    "management",
    "algeria"
  ],
  "author": "SDIDSA",
  "license": "proprietary",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.2",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
