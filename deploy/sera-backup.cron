# Sera nightly backup + maintenance (installed by prod.sh --backup-cron)
# Runs as the app user (who owns the self-contained PG in .prod-tools) and
# connects with .env credentials. To enable offsite copies, configure rclone
# for that user and set __OFFSITE__ to an rclone destination (remote:bucket/sera).
30 2 * * * __SVC_USER__ APP_DIR=__APP_DIR__ OFFSITE_REMOTE=__OFFSITE__ /bin/bash __APP_DIR__/deploy/backup.sh >> /var/log/sera-backup.log 2>&1
