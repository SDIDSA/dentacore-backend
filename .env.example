# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentacore
DB_USER=dentacore
DB_PASSWORD=CHANGE_ME_TO_STRONG_CREDENTIAL
# Set to true only when the Postgres server requires SSL (e.g. managed cloud DBs)
DB_SSL=false

# JWT - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_HEX_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
# For development: http://localhost:5173,http://localhost:3000
# For production: set to your exact frontend URL (e.g. https://app.example.com)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
NODE_ENV=development
# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info
# Appointment reminder scheduler cadence (milliseconds; default 900000 = 15 min)
REMINDER_INTERVAL_MS=900000

# SMTP (optional — enables email/SMS notification delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dentacore.dz

# Cloudinary (optional for dev)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# File Upload
MAX_FILE_SIZE=20971520
