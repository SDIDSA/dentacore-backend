# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentacore
DB_USER=dentacore
DB_PASSWORD=CHANGE_ME_TO_STRONG_CREDENTIAL

# JWT - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_HEX_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
# For development: http://localhost:5173,http://localhost:3000
# For production: set to your exact frontend URL (e.g. https://app.example.com)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
NODE_ENV=development

# Cloudinary (optional for dev)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# File Upload
MAX_FILE_SIZE=20971520
