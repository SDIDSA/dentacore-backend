# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentacore
DB_USER=dentacore
DB_PASSWORD=CHANGE_ME_TO_STRONG_CREDENTIAL

# JWT - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_HEX_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
# WARNING: In production, set this to your exact frontend URL (e.g. https://app.example.com).
# Using * with credentials: true is not supported by browsers.
# For multiple origins, comma-separate: https://app1.example.com,https://app2.example.com
CORS_ORIGIN=*
# WARNING: Set to 'production' in production environments
NODE_ENV=development

# Cloudinary (optional for dev)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# File Upload
MAX_FILE_SIZE=20971520
